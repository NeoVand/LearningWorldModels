{
  "name": "before-the-move",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-edition2.mjs",
    "verify": "node tools/verify-edition2.mjs",
    "build:revision": "node tools/build-edition2.mjs",
    "verify:revision": "node tools/verify-edition2.mjs",
    "verify:pedagogy": "node tools/verify-pedagogy.mjs",
    "verify:polish": "node tools/verify-polish.mjs",
    "verify:visuals": "node tools/verify-visual-numerics.mjs && node tools/verify-completed-book.mjs",
    "verify:continuous": "node tools/verify-continuous.mjs",
    "audit:visuals": "node tools/audit-visuals.mjs",
    "print": "node tools/print-edition2.mjs",
    "verify:layout": "node tools/verify-figure-layout.mjs",
    "verify:editorial": "node tools/verify-editorial.mjs",
    "verify:camera": "node tools/verify-camera.mjs && node tools/verify-camera-visual.mjs",
    "verify:voice": "node tools/verify-voice-index.mjs --dom && node tools/verify-live-model-switch.mjs && node tools/verify-voice-experience.mjs && npm run verify:voice:navigation",
    "verify:voice:navigation": "node tools/verify-voice-navigation.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.2",
    "@jax-js/jax": "0.1.18",
    "highlight.js": "11.11.1",
    "katex": "0.16.22",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.55.1"
  },
  "engines": {
    "node": ">=22"
  }
}
